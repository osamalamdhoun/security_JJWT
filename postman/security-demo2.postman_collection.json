{
  "info": {
    "name": "Security Demo 2 - JJWT, roles and authorities",
    "description": "Local teaching example. Start the backend and run requests in numbered order. Collection scripts save demo tokens and IDs. Expected 400/401/403/404/409 responses are successful negative tests. Each run leaves one new learner USER in the database; created products are deleted at the end. Demo credentials match application.properties. Never export real tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "managerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "learnerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "learnerEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "learnerId",
      "value": "",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "learnerProductId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Public hello",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/public/hello",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Register a learner (always USER)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "description": "Generates a fresh email on each send. Creates a learning account in your local database.",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Learner\",\n  \"email\": \"{{learnerEmail}}\",\n  \"password\": \"Learner12345!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"learnerEmail\", \"learner.\" + pm.variables.replaceIn(\"{{$guid}}\") + \"@example.com\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "if (pm.response.code === 201) { const body = pm.response.json(); pm.collectionVariables.set(\"learnerToken\", body.accessToken); pm.collectionVariables.set(\"learnerId\", body.user.id); }",
              "pm.test(\"Registration grants only USER and never exposes passwords\", function () { const user = pm.response.json().user; pm.expect(user.role).to.eql(\"USER\"); pm.expect(user).not.to.have.property(\"passwordHash\"); });"
            ]
          }
        }
      ]
    },
